# FitCore production environment template.
#
#   cp deploy/.env.prod.example .env
#   ./scripts/gen-secrets.sh           # fills the REQUIRED secret placeholders
#   vim .env                           # set FITCORE_DOMAIN + CADDY_EMAIL etc.
#
# Every REQUIRED value below fails closed: the prod compose file refuses to
# start if it is empty.

# --- REQUIRED secrets (generated by scripts/gen-secrets.sh) ---
# URL-safe min 16 chars; used directly in connection URLs.
POSTGRES_PASSWORD=__GENERATE_32HEX__
# JWT signing secret; must be at least 32 bytes. Rotating it invalidates all
# active sessions (see docs/PROD.md).
TOKEN_SECRET=__GENERATE_48HEX__
# Grafana operator login (the UI is bound to loopback only).
GRAFANA_ADMIN_PASSWORD=__GENERATE_24HEX__

# --- REQUIRED public settings ---
# Public hostname of the API, e.g. api.fitcore.example. Its A/AAAA record must
# point at this VPS; Caddy obtains/registers TLS automatically.
FITCORE_DOMAIN=api.fitcore.example
# ACME account email (expiry + renewal notices).
CADDY_EMAIL=ops@example.com

# --- Optional tuning ---
TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
# Alert delivery webhook (e.g. custom Slack/Teams/Mattermost URL).
ALERTMANAGER_WEBHOOK_URL=
FITCORE_TAG=main