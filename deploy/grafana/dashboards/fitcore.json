{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(rate(fitcore_http_requests_total[5m]))",
          "legendFormat": "requests/s"
        }
      ],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fitcore_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(fitcore_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "title": "Latency (p95 / p99)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(fitcore_memberships_purchased_total)",
          "legendFormat": "memberships purchased"
        }
      ],
      "title": "Memberships purchased",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(rate(fitcore_http_requests_total{status=~\"5..\"}[5m])) by (path)",
          "legendFormat": "{{path}}"
        }
      ],
      "title": "5xx per route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "errors",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(rate(fitcore_database_errors_total[5m])) by (module, operation)",
          "legendFormat": "{{module}}/{{operation}}"
        }
      ],
      "title": "Database errors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "ds_prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 6,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        { "expr": "go_goroutines", "legendFormat": "goroutines" },
        { "expr": "process_resident_memory_bytes", "legendFormat": "memory" }
      ],
      "title": "Runtime",
      "type": "timeseries"
    }
