# Build stage
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/fitcore-migrate ./cmd/migrate

# Runtime stage
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 fitcore
COPY --from=build /out/fitcore-migrate /usr/local/bin/fitcore-migrate
USER fitcore
WORKDIR /work
ENTRYPOINT ["fitcore-migrate"]