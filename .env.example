# Application
FITCORE_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080

# HTTP server timeouts (see internal/config/config.go for defaults)
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# Auth (TOKEN_SECRET is required, >= 32 bytes; generate with: openssl rand -base64 48)
TOKEN_SECRET=
TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Redis
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Database
POSTGRES_USER=fitcore
POSTGRES_PASSWORD=fitcore
POSTGRES_DB=fitcore
POSTGRES_PORT=5432
DATABASE_URL=postgres://fitcore:fitcore@localhost:5432/fitcore?sslmode=disable

# App-side DB pool (DB_MAX_OPEN_CONNS must stay <= pgbouncer DEFAULT_POOL_SIZE 20)
DB_MAX_OPEN_CONNS=15
DB_MAX_IDLE_CONNS=5

# Test database (integration tests)
TEST_DATABASE_URL=postgres://fitcore:fitcore@localhost:5432/fitcore_test?sslmode=disable

# pgbouncer
PGBOUNCER_PORT=6432

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093
# Webhook receiving Alertmanager notifications. Leave empty to keep alerts
# local: with no URL the alertmanager entrypoint falls back to a log receiver,
# so alerts are only visible in the Alertmanager UI/API and container logs.
ALERTMANAGER_WEBHOOK_URL=

# Server port publish on the host
SERVER_PORT=8080