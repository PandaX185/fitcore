# Application
FITCORE_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080

# Database
POSTGRES_USER=fitcore
POSTGRES_PASSWORD=fitcore
POSTGRES_DB=fitcore
POSTGRES_PORT=5432
DATABASE_URL=postgres://fitcore:fitcore@localhost:5432/fitcore?sslmode=disable

# Test database (integration tests)
TEST_DATABASE_URL=postgres://fitcore:fitcore@localhost:5432/fitcore_test?sslmode=disable

# pgbouncer
PGBOUNCER_PORT=6432

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERTMANAGER_PORT=9093
# Leave empty to disable webhook delivery
ALERTMANAGER_WEBHOOK_URL=

# Server port publish on the host
SERVER_PORT=8080